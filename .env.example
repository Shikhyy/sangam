# Copy to .env and fill in. Never commit .env. Never paste keys in chat.

# "mock" runs with scripted replies and needs no keys. "live" uses the providers below.
SANGAM_MODE=mock

# OpenRouter (language model for replies). Only free models are allowed (ids ending in ":free").
OPENROUTER_API_KEY=
# Optional, comma separated, tried in order. Empty uses Gemma 4 31B, then Gemma 4 26B, then Nemotron 3 Ultra,
# then OpenRouter's free router.
OPENROUTER_MODEL=

# Gnani (speech)
GNANI_API_KEY=
# Chosen from Gnani's docs: Prisma v3.0 handles mixed Hindi and English, Timbre v3.0 voices speak both.
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
# Listen for Hindi and English; "codemix" keeps English words in Latin script.
GNANI_STT_LANGUAGES=hi-IN,en-IN
GNANI_STT_FORMAT=codemix
# Hinglish
GNANI_TTS_LANGUAGE=hi-en

# Existing Claude provider; leave empty if you only use OpenRouter
ANTHROPIC_API_KEY=

# Spend and rate guards. Blank uses the default shown. 0 blocks that thing entirely.
# Speech seconds the whole site may use per UTC day (default 900 = 15 minutes)
SANGAM_DAILY_SPEECH_CAP_SEC=
# Speech seconds one visitor may use per hour (default 120)
SANGAM_SESSION_SPEECH_CAP_SEC=
# Speech requests one visitor may make per minute (default 20)
SANGAM_SPEECH_PER_MIN=
# Reply requests one visitor may make per minute; each "Get replies" makes two (default 12)
SANGAM_REPLY_PER_MIN=
# Reply requests the whole site may make per minute (default 18, just under OpenRouter's free 20)
SANGAM_REPLY_GLOBAL_PER_MIN=
# Reply requests the whole site may make per UTC day (default 45, under the free 50 a day)
SANGAM_REPLY_DAILY_CAP=

# The public address of the site, used for share previews and the sitemap. Leave blank locally.
NEXT_PUBLIC_SITE_URL=

# Optional API keys for the public /api/v1 endpoints, comma separated. Blank leaves the API open
# (fine locally and for the demo). Anyone who sends one of these gets their own rate limit.
SANGAM_API_KEYS=
# Public API requests per key (or per visitor when open) per minute (default 60)
SANGAM_API_PER_MIN=
